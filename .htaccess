# Apache URL Rewriting
# Chuyển tất cả request về index.php (Front Controller pattern)

Options -Indexes
RewriteEngine On

# Nếu request tới file/thư mục thực sự tồn tại (CSS, JS, ảnh...) → không rewrite
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Các request khác đều chuyển hết về index.php
RewriteRule ^(.*)$ index.php [QSA,L]
